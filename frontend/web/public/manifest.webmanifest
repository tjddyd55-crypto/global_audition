{
  "name": "Global Audition",
  "short_name": "Audition",
  "description": "글로벌 오디션 플랫폼 - 지원, 관리, 투표를 하나의 앱에서",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#000000",
  "theme_color": "#000000",
  "lang": "ko",
  "categories": [
    "entertainment",
    "social",
    "productivity"
  ],
  "icons": [
    {
      "src": "/apple-icon",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "prefer_related_applications": true,
  "related_applications": [
    {
      "platform": "play",
      "id": "com.globalaudition.app",
      "url": "https://play.google.com/store/apps/details?id=com.globalaudition.app"
    }
  ]
}
