# =============================================================================
# Frontend Web — 환경 변수 예시 (.env.local 등)
# =============================================================================
#
# API는 브라우저에서 `/api/...` 만 호출합니다. Next.js가 백엔드로 프록시(rewrites).

# Next 서버 전용: rewrite 대상 백엔드 Origin (슬래시 없이)
# Railway(프론트) 서비스 변수에 설정 권장. 미설정 시 프로덕션 기본은 backend-production URL.
# BACKEND_PROXY_ORIGIN=https://backend-production-b968.up.railway.app
#
# 로컬 개발: next.config.js 기본은 http://127.0.0.1:8081 — 다른 포트면 설정
# BACKEND_PROXY_ORIGIN=http://127.0.0.1:8080

# 크레딧 목 결제 페이지(/credits/mock-pay) — 운영에서 끄려면 false
# NEXT_PUBLIC_CREDIT_MOCK_PAYMENT=true

# 선택
# NEXT_PUBLIC_LOCALE=ko
# NEXT_PUBLIC_USE_GATEWAY=false
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
