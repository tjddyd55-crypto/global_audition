{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_WEB_URL": "http://10.0.2.2:3000",
        "EXPO_PUBLIC_ALLOWED_HOSTS": "10.0.2.2,localhost"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_WEB_URL": "https://staging.global-audition.example.com",
        "EXPO_PUBLIC_ALLOWED_HOSTS": "staging.global-audition.example.com"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "production-apk": {
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_WEB_URL": "https://global-audition.example.com",
        "EXPO_PUBLIC_ALLOWED_HOSTS": "global-audition.example.com"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_WEB_URL": "https://global-audition.example.com",
        "EXPO_PUBLIC_ALLOWED_HOSTS": "global-audition.example.com"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
