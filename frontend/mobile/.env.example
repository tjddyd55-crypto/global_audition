# Expo 로컬 개발용 환경 변수 예시
# 실제 값은 .env.local 또는 셸 환경변수로 주입한다.
# EAS 빌드 시에는 eas.json의 각 프로필 env가 우선한다.

# 웹 폴백(WebView) URL. API를 따로 안 주면 `${WEB_URL}/api` 를 쓴다.
EXPO_PUBLIC_WEB_URL=http://10.0.2.2:3000

# 기존 프론트 프록시 또는 백엔드 /api origin
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api

# 내부 탐색으로 취급할 호스트 목록(콤마 구분)
EXPO_PUBLIC_ALLOWED_HOSTS=10.0.2.2,localhost
