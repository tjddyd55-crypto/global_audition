// SSOT: Flyway 마이그레이션·JPA 엔티티·API DTO·프론트 types와 동기화.
// 태그: `tags` + `audition_tags` — 오디션의 `tags` text[] 컬럼은 제거됨(V26).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tag {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @unique @db.VarChar(80)
  type         String        @db.VarChar(20)
  isActive     Boolean       @default(true) @map("is_active")
  auditionTags AuditionTag[]

  @@map("tags")
}

model AuditionTag {
  id         String   @id @default(uuid()) @db.Uuid
  auditionId String   @map("audition_id") @db.Uuid
  tagId      String?  @map("tag_id") @db.Uuid
  tagName    String?  @map("tag_name") @db.VarChar(120)
  audition   Audition @relation(fields: [auditionId], references: [id], onDelete: Cascade)
  tag        Tag?     @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@index([auditionId], map: "idx_audition_tags_audition")
  @@map("audition_tags")
}

model Audition {
  id              String   @id @default(uuid()) @db.Uuid
  ownerId         String   @map("owner_id") @db.Uuid
  groupId         String   @map("group_id") @db.Uuid
  seriesRound     Int      @default(1) @map("series_round")
  title           String
  description     String
  status          String
  coverImage         String?  @map("cover_image")
  imageOriginalUrl   String?  @map("image_original_url")
  imageMediumUrl     String?  @map("image_medium_url")
  imageThumbUrl      String?  @map("image_thumb_url")
  videoUrl        String?  @map("video_url")
  galleryImages   String[] @map("gallery_images")
  agencyName      String   @map("agency_name")
  agencyLogo      String?  @map("agency_logo")
  applicantsCount Int      @default(0) @map("applicants_count")
  remainingDays   Int      @map("remaining_days")
  recruitFields   String[] @map("recruit_fields")
  qualifications  String[]
  schedules       String[]
  location        String
  startDate       DateTime @map("start_date")
  endDate         DateTime @map("end_date")
  benefits        String[]
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime? @map("updated_at")
  countryCode     String?  @map("country_code")
  deadlineAt      DateTime? @map("deadline_at")
  defaultLocale   String    @default("ko") @map("default_locale") @db.VarChar(8)

  auditionTags        AuditionTag[]
  auditionTranslations AuditionTranslation[]

  @@map("auditions")
}

model AuditionTranslation {
  auditionId     String   @map("audition_id") @db.Uuid
  locale         String   @db.VarChar(8)
  title          String
  description    String   @default("")
  location       String   @default("")
  agencyName     String   @default("") @map("agency_name")
  recruitFields  String[] @default([]) @map("recruit_fields")
  qualifications String[] @default([])
  schedules      String[] @default([])
  benefits       String[] @default([])
  status         String   @default("COMPLETED")
  provider       String   @default("MANUAL")
  updatedAt      DateTime @default(now()) @map("updated_at")
  createdAt      DateTime @default(now()) @map("created_at")
  audition       Audition @relation(fields: [auditionId], references: [id], onDelete: Cascade)

  @@id([auditionId, locale])
  @@index([locale], map: "idx_audition_translations_locale")
  @@map("audition_translations")
}
